TRACE_DB_PATH=~/TRACE/.trace/trace.db             # caminho do banco (padrão: ~/.surfacer/surfacer.db)
TRACE_SKIP_DAYS=30           # janela de skip por finding recente (padrão: 30)
TRACE_PROFILE_TTL_DAYS=7    # validade do perfil de site em dias (padrão: 7)

TRACE_WORDFENCE_API_KEY=[CHANGE ME]           # obrigatória p/ CVE matching (a que te pegou)
TRACE_WORDFENCE_CACHE=~/TRACE/.cache/wordfence_feed.json             # caminho do cache do feed (padrão: <projeto>/.cache/wordfence_feed.json)
TRACE_WORDFENCE_CACHE_TTL_HOURS=24   # validade do cache em horas (padrão: 24)

OTEL_SERVICE_NAME=trace-scanner
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_TRACES_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_METRICS_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
TRACE_OTEL_CONSOLE=false

NVD_API_KEY=[CHANGE ME]
TRACE_NVD_CACHE_DIR=.cache/nvd
TRACE_NVD_CACHE_TTL_HOURS=168
TRACE_NVD_MIN_REQUEST_INTERVAL=6.2
