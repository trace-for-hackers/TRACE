otelcol.receiver.otlp "trace" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }

  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    traces  = [otelcol.processor.batch.trace.input]
    metrics = [otelcol.processor.batch.trace.input]
    logs    = [otelcol.processor.batch.trace.input]
  }
}

otelcol.processor.batch "trace" {
  timeout = "1s"
  send_batch_size = 512
  send_batch_max_size = 1024

  output {
    traces  = [otelcol.exporter.otlp.tempo.input]
    metrics = [otelcol.exporter.otlp.tempo.input]
    logs    = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"

    tls {
      insecure = true
    }
  }
}
